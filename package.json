{
  "name": "@peter.naydenov/visual-controller-for-svelte3",
  "description": "Tool for building a micro-frontends(MFE) based on Svelte component",
  "version": "3.0.2",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "dist/visual-controller-for-svelte.umd.js",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/visual-controller-for-svelte.esm.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/visual-controller-for-svelte.cjs"
      },
      "default": "./dist/visual-controller-for-svelte.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "rollup -c && npm run types",
    "preview": "vite preview",
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "types": "tsc -p tsconfig.types.json && node scripts/generate-cjs-types.mjs"
  },
  "dependencies": {
    "ask-for-promise": "^3.2.0",
    "svelte": "^4.2.20"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@vitest/coverage-v8": "^2.1.3",
    "jsdom": "^26.0.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.20",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/visual-controller-for-svelte3"
  },
  "keywords": [
    "'micro",
    "frontend",
    "MFE",
    "svelte3",
    "svelte",
    "widgets",
    "visual",
    "controller'"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "types": "./dist/index.d.ts"
}
